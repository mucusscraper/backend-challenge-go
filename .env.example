# Local example values only — no real secrets. Copy to .env to override the
# defaults used by docker-compose.yml (every variable has a default there).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=wagering
# Owner role: runs migrations.
POSTGRES_USER=wagering_owner
POSTGRES_PASSWORD=wagering_owner
# Restricted runtime role used by the service (created by deploy/postgres).
APP_DB_PASSWORD=wallet_app
POSTGRES_HOST_PORT=55432

# --- Keycloak (OIDC IdP) -------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- AWS / LocalStack ------------------------------------------------------------
AWS_REGION=us-east-1
# Principal used by the service against the broker (see queue policies).
SERVICE_AWS_ACCESS_KEY_ID=wallet-service
SERVICE_AWS_SECRET_ACCESS_KEY=wallet-service-local-secret

# --- Service tuning ----------------------------------------------------------------
LOG_LEVEL=info
DATABASE_MAX_CONNS=20
PENDING_MAX_ATTEMPTS=10
PENDING_TTL=10m

# --- Variables read by the service binary (set by docker-compose.yml) -------------
# INSTANCE_ID=app1
# HTTP_ADDR=:8080
# HTTP_REQUEST_TIMEOUT=15s
# DATABASE_URL=postgres://wallet_app:wallet_app@localhost:55432/wagering?sslmode=disable
# DATABASE_LOCK_TIMEOUT=5s
# DATABASE_CONNECT_TIMEOUT=30s
# MIGRATION_DATABASE_URL=postgres://wagering_owner:wagering_owner@localhost:55432/wagering?sslmode=disable
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=wallet-service
# AWS_SECRET_ACCESS_KEY=wallet-service-local-secret
# SQS_CONSUMER_ENABLED=true
# SQS_CONSUMER_NAME=wager-transactions-consumer
# SQS_INBOUND_QUEUE=wager-transactions.fifo
# SQS_INBOUND_DLQ=wager-transactions-dlq.fifo
# SQS_EVENTS_QUEUE=wallet-events.fifo
# SQS_POLLERS=2
# SQS_MAX_MESSAGES=10
# SQS_WAIT_TIME=10s
# SQS_VISIBILITY_TIMEOUT=30s
# SQS_HANDLER_TIMEOUT=20s
# SQS_RETRY_BASE_DELAY=2s
# SQS_RETRY_MAX_DELAY=60s
# SQS_ALLOWED_PROVIDERS=provider-a,provider-b
# OIDC_ISSUER=http://localhost:8080/realms/wagering
# OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
# OIDC_AUDIENCE=wagering-api
# OIDC_PROVIDER_CLAIM=provider_id
# OUTBOX_ENABLED=true
# OUTBOX_POLL_INTERVAL=500ms
# OUTBOX_BATCH_SIZE=50
# OUTBOX_LEASE=30s
# OUTBOX_BASE_BACKOFF=1s
# OUTBOX_MAX_BACKOFF=5m
# PENDING_WORKER_ENABLED=true
# PENDING_POLL_INTERVAL=500ms
# PENDING_BATCH_SIZE=50
# PENDING_BASE_BACKOFF=500ms
# PENDING_MAX_BACKOFF=1m
# SHUTDOWN_TIMEOUT=25s
